STAGE=dev
# Required when STAGE is not dev, test, or local.
WEBHOOK_SECRET_TOKEN=
SCHEDULER_SECRET_TOKEN=
AWS_REGION=eu-west-1
# One of debug, info, warn, warning, or error.
LOG_LEVEL=debug
TELEGRAM_BOT_TOKEN=abcd1234....
MESSAGE_TABLE=messages-table
CHATID_TABLE=chatIds-table
EVENT_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/xxx/yyy
SCALE_UP_READ_CAPACITY=1
# Optional JSON list appended to the off-work message. expires_on is a date
# in Asia/Hong_Kong and the announcement is last live the day before it, so
# 2026-12-26 shows through 25 Dec. Omit expires_on to never expire.
ANNOUNCEMENTS=[{"message":"Happy holidays"},{"message":"Office moves on Monday","expires_on":"2026-12-26"}]
